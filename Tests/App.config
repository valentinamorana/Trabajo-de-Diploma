<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sponsorable="true" />
    </startup>
    <!--
      Solo existe para que Seguridad.Acceso.GetInstance() (Singleton, DAL.BaseDAL<T>) no
      tire InvalidOperationException al construirse — su constructor exige que la entrada
      "WardrobeFlowDB" EXISTA en ConnectionStrings, aunque nunca llegue a abrir la conexión
      (los tests unitarios usan Fakes; ningún test de este proyecto ejecuta una consulta
      real). Sin este archivo, cualquier BLL que instancie un DAL concreto en un campo
      (ej. BLL.Cliente con DAL.PlanSuscripcion) explota en el constructor incluso si el
      resto de sus dependencias están mockeadas. Mismo connectionString que GUI/App.config.
    -->
    <connectionStrings>
        <add name="WardrobeFlowDB"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=WardrobeFlowDB;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
