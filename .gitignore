# Build output
bin/
obj/
*.user
*.suo
.vs/

# NuGet
packages/
*.nupkg

# AES encryption key — regenerate per environment, never commit
key.dat

# Backups de base de datos — nunca versionar (contienen hashes, DNI cifrados, datos de clientes)
*.bak

# Credenciales generadas en texto plano — nunca versionar
CredencialesGeneradas/

# Resultados de tests
TestResults/

# Local settings
*.local

# Certificados de firma (contienen la clave privada)
*.pfx

# Carpeta de trabajo local de Claude Code (worktrees temporales)
.claude/worktrees/

# Instalador oficial de SQL Server LocalDB (lo descarga compilar-y-firmar.ps1)
Instalador/Redist/

# Instalador compilado (se distribuye firmado como GitHub Release, no se versiona)
Instalador/Salida/

# Copia comprimida local del instalador (no se versiona)
/Instalador.zip

# Configuración local de Claude Code (permisos de esta PC)
.claude/settings.local.json

# Modelo de Enterprise Architect: pesa ~100 MB (límite de GitHub); queda solo local
*.eapx
