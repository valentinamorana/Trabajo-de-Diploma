  Usuario ||--o{ SolicitudBajaPromocion : "IdUsuarioSolicita"
  Usuario |o--o{ SolicitudBajaPromocion : "IdUsuarioResuelve"
  Promocion ||--o{ SolicitudBajaPromocion : "IdPromocion"
  Categoria |o--o{ SugerenciaPromocion : "CategoriaPrenda"
  Usuario |o--o{ SugerenciaPromocion : "IdUsuarioAlta"
  PlanSuscripcion |o--o{ SugerenciaPromocion : "IdPlan"
  Usuario {
    int IdUsuario PK
    nvarchar(100) Username
    nvarchar(500) Clave
    nvarchar(100) Rol "NULL"
    nvarchar(100) Perfil "NULL"
    bit Estado
    int IntentosFallidos
    int DVH "NULL"
    varchar(5) IdIdioma FK "NULL"
    bit Activo
    datetime FechaBaja "NULL"
    int CantidadBloqueos
    datetime FechaBloqueo "NULL"
    bit RequiereCambioClave
    nvarchar(100) Nombre "NULL"
    nvarchar(100) Apellido "NULL"
    date FechaNacimiento "NULL"
    nvarchar(200) Email "NULL"
  }
  PlanSuscripcion {
    int IdPlan PK
    nvarchar(100) Nombre
    int LimitePrendas
    decimal(10_2) Precio
    bit Estado
  }
  Categoria {
    int IdCategoria PK
    nvarchar(100) Nombre
    bit Activo
  }
  SugerenciaPromocion {
    int IdSugerencia PK
    int IdPlan FK "NULL"
    nvarchar(100) CategoriaPrenda FK "NULL"
    nvarchar(500) Motivo
    int TipoDescuentoSugerido
    decimal(10_2) BeneficioEstimado
    int Estado
    datetime FechaAlta
    int OrigenMetrica
    int IdUsuarioAlta FK "NULL"
    nvarchar(500) MotivoDescarte "NULL"
    datetime FechaEvaluacion "NULL"
  }
  Promocion {
    int IdPromocion PK
    nvarchar(150) Nombre
    nvarchar(500) Descripcion "NULL"
    int TipoDescuento
    decimal(10_2) Valor
    date FechaInicio
    date FechaFin
    int Estado
    int IdPlan FK "NULL"
    nvarchar(100) CategoriaPrenda FK "NULL"
    decimal(10_2) MargenEstimado
    nvarchar(500) ImpactoEconomico "NULL"
    int IdSugerenciaOrigen FK "NULL"
    datetime FechaAlta
    int IdUsuarioAlta FK "NULL"
  }
  PromocionHistorial {
    int IdHistorial PK
    int IdPromocion FK
    int EstadoAnterior "NULL"
    int EstadoNuevo
    int IdUsuario FK "NULL"
    datetime Fecha
    nvarchar(500) Observacion "NULL"
  }
  DictamenContable {
    int IdDictamen PK
    int IdPromocion FK
    int IdUsuario FK
    bit Aprobada
    nvarchar(500) Observacion
    datetime Fecha
  }
  SolicitudBajaPromocion {
    int IdSolicitud PK
    int IdPromocion FK
    int IdUsuarioSolicita FK
    nvarchar(500) Motivo
    datetime FechaSolicitud
    int Estado
    int IdUsuarioResuelve FK "NULL"
    nvarchar(500) MotivoResolucion "NULL"
    datetime FechaResolucion "NULL"
  }
  Contratacion {
    int IdContratacion PK
    int IdCliente FK
    int IdPlan FK
    int IdVendedor FK
    int IdCaja FK "NULL"
    int Modalidad
    int Estado
    datetime FechaAlta
    datetime FechaResolucion "NULL"
    nvarchar(50) NumeroComprobante "NULL"
    datetime FechaComprobante "NULL"
    decimal(10_2) Importe "NULL"
    decimal(10_2) DescuentoAplicado "NULL"
    int IdPromocion FK "NULL"
    int IdMedioPago FK "NULL"
    date VigenciaDesde "NULL"
    date VigenciaHasta "NULL"
    decimal(10_2) PrecioMensual "NULL"
    int IdReferenteAcreditado FK "NULL"
    int IdPlanCuotas FK "NULL"
    decimal(10_2) RecargoCuotas "NULL"
    decimal(10_2) CreditoCambioPlan "NULL"
    nvarchar(200) MotivoAnulacion "NULL"
    int DVH "NULL"
  }
  Cliente {
    int IdCliente PK
    nvarchar(100) Nombre
    nvarchar(100) Apellido
    nvarchar(200) DNI
    nvarchar(200) Email "NULL"
    int IdPlan FK "NULL"
    datetime FechaAlta
    date FechaNacimiento
    bit Activo
    int DVH "NULL"
    date FechaVencimiento "NULL"
    date FechaLimiteGracia "NULL"
    datetime FechaPausaHasta "NULL"
    int IdClienteReferente FK "NULL"
    decimal(10_2) DescuentoProximoCobro
    bit BeneficioReferidoOtorgado
    int IdMedioPagoPreferido FK "NULL"
    int IdPlanSiguiente FK "NULL"
    datetime FechaCambioPlan "NULL"
  }
  HistorialCobro {
    int IdCobro PK
    int IdCliente FK
    decimal(10_2) Importe
    datetime FechaDeteccion
    datetime FechaResolucion "NULL"
    int Resultado
    nvarchar(100) Actor "NULL"
    int IdMedioPago FK "NULL"
    nvarchar(50) NumeroComprobante "NULL"
    int Modalidad "NULL"
    decimal(10_2) DescuentoAplicado "NULL"
    int IdPromocion FK "NULL"
  }
