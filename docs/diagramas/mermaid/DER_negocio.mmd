erDiagram
  Prenda ||--o{ CargoPrenda : "IdPrenda"
  Cliente ||--o{ CargoPrenda : "IdCliente"
  Cliente |o--o{ Cliente : "IdClienteReferente"
  PlanSuscripcion |o--o{ Cliente : "IdPlan"
  PlanSuscripcion ||--o{ Contratacion : "IdPlan"
  Promocion |o--o{ Contratacion : "IdPromocion"
  Cliente ||--o{ Contratacion : "IdCliente"
  Cliente |o--o{ Contratacion : "IdReferenteAcreditado"
  Empleado ||--o{ Contratacion : "IdVendedor"
  Empleado |o--o{ Contratacion : "IdCaja"
  Promocion ||--o{ DictamenContable : "IdPromocion"
  Cliente ||--o{ HistorialCobro : "IdCliente"
  Cliente ||--o{ HistorialRenovacion : "IdCliente"
  PlanSuscripcion |o--o{ HistorialRenovacion : "IdPlanAnterior"
  PlanSuscripcion |o--o{ HistorialRenovacion : "IdPlanNuevo"
  Cliente ||--o{ ListaEspera : "IdCliente"
  Prenda ||--o{ ListaEspera : "IdPrenda"
  Prenda ||--o{ MantenimientoPrenda : "IdPrenda"
  Cliente ||--o{ Pedido : "IdCliente"
  Empleado ||--o{ Pedido : "IdEmpleado"
  Empleado |o--o{ Pedido : "IdEmpleadoControl"
  Pedido ||--o{ PedidoHistorial : "IdPedido"
  Pedido ||--o{ PedidoPrenda : "IdPedido"
  Prenda ||--o{ PedidoPrenda : "IdPrenda"
  Cliente |o--o{ Prenda : "IdClienteActual"
  Cliente |o--o{ Prenda : "IdUltimoCliente"
  PlanSuscripcion |o--o{ Promocion : "IdPlan"
  SugerenciaPromocion |o--o{ Promocion : "IdSugerenciaOrigen"
  Promocion ||--o{ PromocionHistorial : "IdPromocion"
  Promocion ||--o{ SolicitudBajaPromocion : "IdPromocion"
  PlanSuscripcion |o--o{ SugerenciaPromocion : "IdPlan"
  PlanSuscripcion {
    int IdPlan PK
    nvarchar(100) Nombre
    int LimitePrendas
    decimal(10_2) Precio
    bit Estado
  }
  Cliente {
    int IdCliente PK
    nvarchar(100) Nombre
    nvarchar(100) Apellido
    nvarchar(200) DNI
    nvarchar(200) Email "NULL"
    nvarchar(100) MetodoPago "NULL"
    int IdPlan FK "NULL"
    datetime FechaAlta
    date FechaNacimiento
    bit Activo
    int DVH "NULL"
    date FechaVencimiento "NULL"
    date FechaLimiteGracia "NULL"
    datetime FechaPausaHasta "NULL"
    int IdClienteReferente FK "NULL"
    decimal(10_2) DescuentoProximoCobro
    bit BeneficioReferidoOtorgado
  }
  Empleado {
    int IdEmpleado PK
    nvarchar(100) Nombre
    nvarchar(100) Apellido
    nvarchar(200) DNI
    nvarchar(200) Email "NULL"
    datetime FechaIngreso
    nvarchar(100) Puesto "NULL"
    nvarchar(50) Legajo "NULL"
    int IdUsuario FK "NULL"
    int DVH "NULL"
  }
  Contratacion {
    int IdContratacion PK
    int IdCliente FK
    int IdPlan FK
    int IdVendedor FK
    int IdCaja FK "NULL"
    int Modalidad
    int Estado
    datetime FechaAlta
    datetime FechaResolucion "NULL"
    nvarchar(50) NumeroComprobante "NULL"
    datetime FechaComprobante "NULL"
    decimal(10_2) Importe "NULL"
    decimal(10_2) DescuentoAplicado "NULL"
    int IdPromocion FK "NULL"
    int IdMedioPago FK "NULL"
    date VigenciaDesde "NULL"
    date VigenciaHasta "NULL"
    decimal(10_2) PrecioMensual "NULL"
    int IdReferenteAcreditado FK "NULL"
    int DVH "NULL"
  }
  Promocion {
    int IdPromocion PK
    nvarchar(150) Nombre
    nvarchar(500) Descripcion "NULL"
    int TipoDescuento
    decimal(10_2) Valor
    date FechaInicio
    date FechaFin
    int Estado
    int IdPlan FK "NULL"
    nvarchar(100) CategoriaPrenda "NULL"
    decimal(10_2) MargenEstimado
    nvarchar(500) ImpactoEconomico "NULL"
    int IdSugerenciaOrigen FK "NULL"
    datetime FechaAlta
    int IdUsuarioAlta FK "NULL"
  }
  SugerenciaPromocion {
    int IdSugerencia PK
    int IdPlan FK "NULL"
    nvarchar(100) CategoriaPrenda "NULL"
    nvarchar(500) Motivo
    int TipoDescuentoSugerido
    decimal(10_2) BeneficioEstimado
    int Estado
    datetime FechaAlta
    int OrigenMetrica
    int IdUsuarioAlta FK "NULL"
    nvarchar(500) MotivoDescarte "NULL"
    datetime FechaEvaluacion "NULL"
  }
  PromocionHistorial {
    int IdHistorial PK
    int IdPromocion FK
    int EstadoAnterior "NULL"
    int EstadoNuevo
    int IdUsuario FK "NULL"
    datetime Fecha
    nvarchar(500) Observacion "NULL"
  }
  DictamenContable {
    int IdDictamen PK
    int IdPromocion FK
    int IdUsuario FK
    bit Aprobada
    nvarchar(500) Observacion
    datetime Fecha
  }
  SolicitudBajaPromocion {
    int IdSolicitud PK
    int IdPromocion FK
    int IdUsuarioSolicita FK
    nvarchar(500) Motivo
    datetime FechaSolicitud
    int Estado
    int IdUsuarioResuelve FK "NULL"
    nvarchar(500) MotivoResolucion "NULL"
    datetime FechaResolucion "NULL"
  }
  HistorialRenovacion {
    int IdRenovacion PK
    int IdCliente FK
    int IdPlanAnterior FK "NULL"
    int IdPlanNuevo FK "NULL"
    datetime FechaDeteccion
    datetime FechaResolucion "NULL"
    int Resultado
    nvarchar(100) Actor "NULL"
  }
  HistorialCobro {
    int IdCobro PK
    int IdCliente FK
    decimal(10_2) Importe
    datetime FechaDeteccion
    datetime FechaResolucion "NULL"
    int Resultado
    nvarchar(100) Actor "NULL"
  }
  Pedido {
    int IdPedido PK
    int IdCliente FK
    int IdEmpleado FK
    int Estado
    datetime FechaPedido
    datetime FechaDespacho "NULL"
    datetime FechaEntrega "NULL"
    nvarchar(500) MotivoCancelacion "NULL"
    int DVH "NULL"
    datetime FechaEnvioControl "NULL"
    datetime FechaControl "NULL"
    int IdEmpleadoControl FK "NULL"
    datetime FechaSeparacion "NULL"
    datetime FechaFormalizacion "NULL"
    nvarchar(500) MotivoDesistimiento "NULL"
    nvarchar(20) EtapaDesistimiento "NULL"
  }
  PedidoPrenda {
    int IdPedido PK,FK
    int IdPrenda PK,FK
    bit Confirmada
  }
  PedidoHistorial {
    int IdHistorial PK
    int IdPedido FK
    int IdOperacion
    datetime Fecha
    int IdUsuario FK "NULL"
    nvarchar(200) NombreUsuario "NULL"
    nvarchar(200) Accion
    nvarchar(100) Campo
    nvarchar(1000) ValorAnterior "NULL"
    nvarchar(1000) ValorNuevo "NULL"
  }
  Prenda {
    int IdPrenda PK
    nvarchar(100) Nombre
    nvarchar(500) Descripcion "NULL"
    nvarchar(20) Talle "NULL"
    nvarchar(50) Color "NULL"
    nvarchar(100) Categoria "NULL"
    int Estado
    int IdClienteActual FK "NULL"
    datetime FechaAlta
    int IdUltimoCliente FK "NULL"
    decimal(10_2) PrecioReposicion "NULL"
  }
  MantenimientoPrenda {
    int IdMantenimiento PK
    int IdPrenda FK
    datetime FechaEntrada
    datetime FechaSalida "NULL"
    nvarchar(100) Actor "NULL"
  }
  CargoPrenda {
    int IdCargo PK
    int IdPrenda FK
    int IdCliente FK
    nvarchar(200) Motivo
    decimal(10_2) Monto
    datetime FechaRegistro
    datetime FechaCobro "NULL"
    nvarchar(100) Actor "NULL"
    int Estado
  }
  ListaEspera {
    int IdListaEspera PK
    int IdPrenda FK
    int IdCliente FK
    datetime FechaAlta
    int Estado
    datetime FechaLimiteReserva "NULL"
    datetime FechaResolucion "NULL"
    nvarchar(100) Actor "NULL"
  }
