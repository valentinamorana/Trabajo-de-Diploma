erDiagram
  Permiso ||--o{ ControlMapeado : "IdPermiso"
  Permiso ||--o{ PermisoRelacion : "IdPadre"
  Permiso ||--o{ PermisoRelacion : "IdHijo"
  Control ||--o{ Traduccion : "IdControl"
  Idioma ||--o{ Traduccion : "IdIdioma"
  Permiso {
    int IdPermiso PK
    nvarchar(100) Nombre
    nvarchar(100) NombreMenu "NULL"
    nvarchar(100) TipoComponente "NULL"
    bit Estado
    bit EsFamilia
    bit EsRol
  }
  PermisoRelacion {
    int IdPadre PK,FK
    int IdHijo PK,FK
    int DVH "NULL"
  }
  Control {
    int IdControl PK
    varchar(100) Clave
    varchar(50) Formulario
  }
  ControlMapeado {
    int IdControlMapeado PK
    int IdPermiso FK
    nvarchar(100) Formulario
    nvarchar(100) NombreControl
  }
  Idioma {
    int IdIdioma PK
    varchar(5) Codigo
    nvarchar(50) Nombre
    bit Activo
    bit EsDefault
  }
  Traduccion {
    int IdControl PK,FK
    int IdIdioma PK,FK
    nvarchar(1000) Texto
  }
