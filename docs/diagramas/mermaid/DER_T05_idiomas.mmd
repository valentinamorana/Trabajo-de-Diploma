erDiagram
  Permiso ||--o{ ControlMapeado : "IdPermiso"
  Usuario ||--o{ Preferencia : "IdUsuario"
  Control ||--o{ Traduccion : "IdControl"
  Idioma ||--o{ Traduccion : "IdIdioma"
  Idioma |o--o{ Usuario : "IdIdioma"
  Idioma {
    int IdIdioma PK
    varchar(5) Codigo
    nvarchar(50) Nombre
    bit Activo
    bit EsDefault
  }
  Traduccion {
    int IdControl PK,FK
    int IdIdioma PK,FK
    nvarchar(1000) Texto
  }
  Control {
    int IdControl PK
    varchar(100) Clave
    varchar(50) Formulario
  }
  ControlMapeado {
    int IdControlMapeado PK
    int IdPermiso FK
    nvarchar(100) Formulario
    nvarchar(100) NombreControl
  }
  Preferencia {
    int IdUsuario PK,FK
    nvarchar(50) FuenteFamilia "NULL"
    varchar(10) FuenteTamano "NULL"
    varchar(20) Tema "NULL"
    varchar(20) FormatoFecha "NULL"
    bit Notificaciones "NULL"
  }
  Usuario {
    int IdUsuario PK
    nvarchar(100) Username
    nvarchar(500) Clave
    nvarchar(100) Rol "NULL"
    nvarchar(100) Perfil "NULL"
    bit Estado
    int IntentosFallidos
    int DVH "NULL"
    varchar(5) IdIdioma FK "NULL"
    bit Activo
    datetime FechaBaja "NULL"
    int CantidadBloqueos
    datetime FechaBloqueo "NULL"
    bit RequiereCambioClave
    nvarchar(100) Nombre "NULL"
    nvarchar(100) Apellido "NULL"
    date FechaNacimiento "NULL"
    nvarchar(200) Email "NULL"
  }
  Permiso {
    int IdPermiso PK
    nvarchar(100) Nombre
    nvarchar(100) NombreMenu "NULL"
    nvarchar(100) TipoComponente "NULL"
    bit Estado
    bit EsFamilia
    bit EsRol
  }
