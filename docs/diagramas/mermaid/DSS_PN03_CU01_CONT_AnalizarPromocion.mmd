sequenceDiagram
  autonumber
  actor K as Contabilidad
  participant F as Promociones<br/>ContabilidadForm
  participant B as BLL.Promocion
  participant D as DAL.Promocion
  participant DS as DAL.Sugerencia<br/>Promocion
  participant DP as DAL.Plan<br/>Suscripcion
  participant DC as DAL.Cliente
  Note over K,F: Analiza el margen y el impacto → ¿Aprueba?
  F->>B: ObtenerPendientesRevisionContable()
  B->>D: ObtenerPendientesRevisionContable()
  B-->>F: promociones En Revisión Contable
  K->>F: Selecciona una promoción
  F->>B: AnalizarMargenEImpacto(idPromocion)
  Note over B: PermisosAccion.Exigir(PromocionesContable, PromocionesContable)
  B->>D: ObtenerPorId(idPromocion)
  alt Ya no existe
    D-->>B: null
    B-->>F: AppException(inexistente)
    F-->>K: Informa el error
  else Existe
    D-->>B: promocion
    B->>B: PuedeDictaminar(promocion)  [quien la creó no la dictamina, salvo el Administrador]
    B->>D: ObtenerTodas()  [Superpuestas: las que cumplen promocion.SeSuperponeCon]
    opt Viene de una sugerencia (IdSugerenciaOrigen.HasValue)
      B->>DS: ObtenerPorId(idSugerencia)  [idSugerencia = promocion.IdSugerenciaOrigen.Value]
      DS-->>B: sugerencia (beneficio estimado y origen)
    end
    B->>B: ProyectarCostoDelDescuento(analisis)
    alt Aplica a un plan (promocion.AplicaAPlan())
      B->>DP: ObtenerPorId(idPlan)  [idPlan = promocion.IdPlan.Value]
      DP-->>B: plan (precio mensual)
      B->>B: PoliticaDescuento.DescuentoDe(promocion, plan.Precio)  [descuento por cliente]
      B->>DC: ContarClientesActivosPorPlan(idPlan)
      DC-->>B: clientes activos del plan
      Note over B: margen proyectado = beneficio estimado − descuento por cliente × clientes activos, conviene si es > 0
    else Por categoría
      Note over B: EsInformativa: no descuenta en el cobro, sin costo proyectado ni resultado
    end
    B-->>F: AnalisisImpactoPromocion (beneficio estimado, margen proyectado, superpuestas, UsuarioPuedeDictaminar)
    F-->>K: Análisis de margen e impacto, Aprobar y Rechazar habilitados solo si puede dictaminar
  end
  K->>F: Ingresa la observación, decide y confirma
  alt Aprueba ("Aprobar y Activar")
    F->>B: AprobarContable(modulo, promocion, observacion)
    B->>B: Dictaminar(promocion, observacion, aprobada)  [aprobada = true → Vigente]
  else Rechaza ("Rechazar")
    F->>B: RechazarContable(modulo, promocion, observacion)
    B->>B: Dictaminar(promocion, observacion, aprobada)  [aprobada = false → RechazadaContabilidad]
  end
  Note over B: Dictaminar: PermisosAccion.Exigir(PromocionesContableEditar, PromocionesContable)
  alt No está En Revisión Contable, la creó el usuario o sin observación
    B-->>F: AppException(revisioncontable_estado / creador_no_dictamina / observacion_requerida)
    F-->>K: Informa el motivo
  else Válido
    B->>D: Dictaminar(dictamen, historial)  [claim: WHERE Estado = EnRevisionContable, + DictamenContable, historial: EnRevisionContable → Vigente o RechazadaContabilidad]
    alt Otra sesión ya la resolvió
      D-->>B: 0
      B-->>F: AppException(estado_concurrente)
      F-->>K: Informa el motivo
    else Dictamen guardado
      D-->>B: idDictamen
      Note over B: bitacora.Registrar(modulo, …) · bitacoraNeg.Registrar(Venta o Cancelacion, …)
      B-->>F: idDictamen
      F-->>K: "Promoción aprobada y activada" o "Promoción rechazada"
      F->>B: ObtenerPendientesRevisionContable()  [recarga la cola]
    end
  end
