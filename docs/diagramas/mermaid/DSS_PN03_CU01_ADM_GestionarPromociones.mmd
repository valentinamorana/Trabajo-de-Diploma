sequenceDiagram
  autonumber
  actor A as Administración
  participant F as Promociones<br/>AdministracionForm
  participant AF as Alta<br/>PromocionForm
  participant B as BLL.Promocion
  participant DS as DAL.Sugerencia<br/>Promocion
  participant D as DAL.Promocion
  A->>F: ¿Acepta la sugerencia? Sí: "Alta desde sugerencia" (o "Alta manual")
  A->>AF: Completa nombre, tipo, valor, vigencia, margen e impacto
  AF->>B: CrearDesdeSugerencia(modulo, idSugerencia, nombre, ..., impacto)  [o CrearManual(...)]
  Note over B: Exigir(PromocionesAdminEditar) · sugerencia.PuedeEvaluarse()
  B->>B: ValidarPromocion(promocion)  [destino único, valor, fechas]
  alt Datos inválidos
    B-->>AF: AppException(motivo)  [la sugerencia sigue Pendiente]
  else Válidos
    B->>DS: MarcarEvaluada(idSugerencia, fecha)  [claim: WHERE Estado = Pendiente]
    alt Otra sesión ya la evaluó
      DS-->>B: false
      B-->>AF: AppException(sugerencia_evaluada)
    else Claim obtenido
      B->>D: Alta(promocion: EnRevisionContable, IdUsuarioAlta, historial: — → EnRevisionContable)
      alt Falla el alta
        B->>DS: ReabrirEvaluacion(idSugerencia)  [compensación]
        B-->>AF: error
      else Alta correcta
        B-->>AF: idPromocion
        F-->>A: Ficha de promoción (PDF) para Contabilidad
      end
    end
  end
  opt ¿Reformular? Sí (promoción Rechazada por Contabilidad)
    AF->>B: Reformular(modulo, promocion)
    Note over B: promocion.PuedeReformularse() · ValidarPromocion(promocion)
    B->>D: Reformular(promocion, historial: RechazadaContabilidad → EnRevisionContable)  [claim]
    F-->>A: Vuelve a revisión contable: nueva Ficha de promoción
  end
