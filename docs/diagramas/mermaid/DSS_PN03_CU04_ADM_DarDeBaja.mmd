sequenceDiagram
  autonumber
  actor A as Administración
  participant F as Promociones<br/>AdministracionForm
  participant B as BLL.Promocion
  participant D as DAL.Promocion
  Note over A,F: Una Vigente (directamente o al atender una solicitud, CU02-ADM) o una Rechazada (¿Reformular? No, «extend» de CU01-ADM)
  A->>F: Elige una promoción Vigente o Rechazada por Contabilidad y pulsa "Dar de baja"
  A->>F: Ingresa el motivo (InputDialog), si cancela, no se da de baja
  F->>B: DarDeBaja(modulo, promocion, motivo)
  alt Sin motivo
    B-->>F: AppException(motivobaja_admin_requerido)
    F-->>A: Informa el motivo
  else Con motivo
    B->>B: DarDeBaja(modulo, promocion, motivo, respuestaSolicitudes)  [respuestaSolicitudes = motivo]
    Note over B: PermisosAccion.Exigir(PromocionesAdminEditar, PromocionesAdmin)
    alt No está Vigente ni Rechazada (PuedeDarseDeBaja / TransicionValida(DadaDeBaja))
      B-->>F: AppException(darbaja_estado)
      F-->>A: Informa el motivo
    else Vigente o Rechazada
      B->>D: DarDeBaja(idPromocion, estadoEsperado, historial, respuestaSolicitudes)  [claim: WHERE Estado = estadoEsperado, historial: Vigente o RechazadaContabilidad → DadaDeBaja, con el motivo, las solicitudes Pendientes pasan a Atendida con DioDeBaja = 1]
      alt false: otra sesión ya la cambió
        D-->>B: false
        B-->>F: AppException(estado_concurrente)
        F-->>A: Informa el motivo
      else true
        D-->>B: true
        Note over B: bitacora.Registrar(modulo, …) · bitacoraNeg.Registrar(Cancelacion, …)
        B-->>F: ok
        F-->>A: "Promoción dada de baja": fin (la «Constancia de baja» está en Imprimir)
        F->>B: ObtenerSolicitudesBajaPendientes() · ObtenerTodas()  [recarga]
      end
    end
  end
