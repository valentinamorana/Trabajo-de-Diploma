# Build output
bin/
obj/
*.user
*.suo
.vs/

# NuGet
packages/
*.nupkg

# AES encryption key — regenerate per environment, never commit
key.dat

# Backups de base de datos — nunca versionar (contienen hashes, DNI cifrados, datos de clientes)
*.bak

# Credenciales generadas en texto plano — nunca versionar
CredencialesGeneradas/

# Resultados de tests
TestResults/

# Local settings
*.local

# Instalador compilado (se genera con Inno Setup desde Instalador/WardrobeFlow_Setup.iss)
Instalador/Salida/

# Certificados de firma (contienen la clave privada)
*.pfx
